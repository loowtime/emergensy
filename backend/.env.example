# RiskPilot environment configuration
# Copy to backend/.env and adjust. Never commit real secrets.

RISKPILOT_ENV=development
RISKPILOT_ADMIN_USER=admin
RISKPILOT_ADMIN_PASSWORD=admin
RISKPILOT_DATABASE_PATH=riskpilot.db
RISKPILOT_PHOTON_URL=https://photon.komoot.io/api/
RISKPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RISKPILOT_LOG_LEVEL=INFO
